readonly OP_VAULT="Development"
readonly OP_ITEM="pydantic-agora"

item=$(op item get "$OP_ITEM" --vault "$OP_VAULT" --format json --reveal) || return 1

export_secret() {
  local value
  value=$(jq -er --arg name "$1" '
    [.fields[] | select(.label == $name)]
    | select(length == 1)
    | .[0].value
    | select(type == "string" and length > 0)
  ' <<< "$item") || {
    printf "1Password: expected one non-empty field '%s' in %s/%s.\n" "$1" "$OP_VAULT" "$OP_ITEM" >&2
    return 1
  }
  export "$1=$value"
}

export_secret OPENAI_API_KEY || return 1
export_secret LOGFIRE_TOKEN || return 1
export_secret POSTGRES_USER || return 1
export_secret POSTGRES_PASSWORD || return 1
export_secret PGADMIN_EMAIL || return 1
export_secret PGADMIN_PASSWORD || return 1

export POSTGRES_HOST="localhost"
export POSTGRES_PORT=5432
export POSTGRES_DB="agora"
export COMPOSE_DISABLE_ENV_FILE=1
unset item
