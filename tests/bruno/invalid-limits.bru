meta {
  name: Reject invalid workflow limits
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/workflows
  body: json
  auth: none
}

body:json {
  {"operation":"add_then_scale","inputs":{"left":1,"right":2},"limits":{"max_calls":5}}
}

assert {
  res.status: eq 422
}

tests {
  for (const [name, limits] of [
    ["zero timeout", { timeout_seconds: 0 }],
    ["excessive timeout", { timeout_seconds: 31 }],
    ["boolean call count", { max_calls: true }],
    ["zero call count", { max_calls: 0 }]
  ]) {
    test("reject " + name, async function () {
      await bru.sendRequest({
        method: "POST", url: bru.getEnvVar("baseUrl") + "/workflows",
        headers: { "Content-Type": "application/json" },
        data: { operation: "add_then_scale", inputs: { left: 1, right: 2 }, limits }
      }, (error, response) => {
        expect(error ? error.status : response.status).to.equal(422);
      });
    });
  }
}
