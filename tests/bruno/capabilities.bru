meta {
  name: Discover model generation
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/capabilities
  auth: none
}

assert {
  res.status: eq 200
  res.body[0].id: eq generate
}

tests {
  test("discovery exposes Pydantic schemas and worker credentials", function () {
    const capability = res.getBody().find(item => item.id === "generate");
    expect(capability.input_schema.properties).to.have.property("prompt");
    expect(capability.input_schema.properties).not.to.have.property("output_schema");
    expect(capability.output_schema.properties.output.type).to.equal("string");
    expect(capability.credentials).to.deep.equal(["OPENAI_API_KEY (worker)"]);
  });
}
