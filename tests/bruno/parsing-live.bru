meta {
  name: Parse a PDF and image into text
  type: http
  seq: 10
  tags: [
    live-model
  ]
}

post {
  url: {{baseUrl}}/tasks/parse/runs
  body: json
  auth: none
}

body:json {
  {"inputs": {"files": [{"kind": "inline", "media_type": "application/pdf", "data": ""}, {"kind": "inline", "media_type": "image/png", "data": ""}]}}
}

assert {
  res.status: eq 202
}

tests {
  const { waitForRun } = require("./helpers/runs.js");
  test("PDF and image text is extracted and persisted", async function () {
    const run = await waitForRun(bru, res.getBody().id, { timeoutMs: 90000 });
    expect(run.status).to.equal("successful");
    expect(run.result.text).to.include("AGORA-PDF");
    expect(run.result.text).to.include("AGORA-IMAGE");
    const saved = await bru.sendRequest({ method: "GET", url: bru.getEnvVar("baseUrl") + "/runs/" + run.id });
    expect(saved.data.result).to.deep.equal(run.result);
  });
}
