meta {
  name: Submit and retrieve a durable run
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/tasks/dummy/runs
  body: json
  auth: none
}

body:json {
  {"inputs":{"left":2,"right":3}}
}

assert {
  res.status: eq 202
  res.body.status: eq waiting
}

tests {
  const { waitForRun } = require("./helpers/runs.js");

  async function checkRun(id, task, inputs, result) {
    const url = bru.getEnvVar("baseUrl") + "/runs/" + id;
    const run = await waitForRun(bru, id);
    expect(run.status).to.equal("successful");
    expect(run.result).to.deep.equal(result);
    expect(run.request.task).to.equal(task);
    expect(run.request.inputs).to.deep.equal(inputs);
    expect(run.created_at).to.be.a("number");
    expect(run.updated_at).to.be.a("number");
    expect(run.error).to.equal(null);
    const saved = await bru.sendRequest({ method: "GET", url });
    expect(saved.status).to.equal(200);
    expect(saved.data).to.deep.equal(run);
  }

  test("separate worker saves the result", async function () {
    const id = res.getBody().id;
    expect(res.getHeaders().location).to.equal("/runs/" + id);
    await checkRun(id, "dummy", { left: 2, right: 3 }, { value: 5 });
  });

  for (const [name, task, inputs, result] of [
    ["defaults with submitted inputs", "dummy", {}, { value: 5 }],
    ["negative sum", "dummy", { left: -5, right: 2 }, { value: -3 }],
    ["wait and sum", "dummy", { left: 4, right: 6, seconds: 0.05 }, { value: 10 }]
  ]) {
    test("separate worker persists " + name, async function () {
      const response = await bru.sendRequest({
        method: "POST", url: bru.getEnvVar("baseUrl") + "/tasks/" + task + "/runs",
        headers: { "Content-Type": "application/json" }, data: { inputs }
      });
      expect(response.status).to.equal(202);
      expect(response.data.status).to.equal("waiting");
      await checkRun(response.data.id, task, inputs, result);
    });
  }
}
