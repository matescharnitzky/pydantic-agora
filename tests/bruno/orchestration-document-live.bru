meta {
  name: Parse decide and conditionally generate with native Monty
  type: http
  seq: 17
  tags: [
    live-model
  ]
}

post {
  url: {{baseUrl}}/orchestrations/runs
  body: json
  auth: none
}

body:json {
  {"prompt": "Use one program: parse the supplied files, decide whether the text includes AGORA-PDF using a boolean question named matched, and only when matched generate a reply containing AGORA-PDF. Return the reply.", "data": {"files": [{"kind": "inline", "media_type": "application/pdf", "data": ""}]}}
}

assert {
  res.status: eq 202
}

tests {
  const { waitForRun } = require("./helpers/runs.js");
  test("composition completes and remains retrievable", async function () {
    const run = await waitForRun(bru, res.getBody().id, {timeoutMs: 180000});
    expect(run.status).to.equal("successful");
    expect(run.result.output).to.include("AGORA-PDF");
    const saved = await bru.sendRequest({method: "GET", url: bru.getEnvVar("baseUrl") + "/runs/" + run.id});
    expect(saved.data).to.deep.equal(run);
  });
}
