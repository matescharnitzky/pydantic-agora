meta {
  name: Generate text with OpenAI
  type: http
  seq: 9
  tags: [
    live-model
  ]
}

post {
  url: {{baseUrl}}/tasks/generate/runs
  body: json
  auth: none
}

body:json {
  {"inputs":{"prompt":"Reply with exactly: hello","instructions":"Follow the requested output exactly."}}
}

assert {
  res.status: eq 202
}

tests {
  async function finished(id) {
    const url = bru.getEnvVar("baseUrl") + "/runs/" + id;
    for (let attempt = 0; attempt < 900; attempt++) {
      const response = await bru.sendRequest({ method: "GET", url });
      expect(response.status).to.equal(200);
      if (["successful", "failed"].includes(response.data.status)) return response.data;
      await new Promise(resolve => setTimeout(resolve, 100));
    }
    throw new Error("Generation did not complete within 90 seconds");
  }

  test("real model text is persisted and retrievable", async function () {
    const run = await finished(res.getBody().id);
    expect(run.status).to.equal("successful");
    expect(run.result.output.trim()).to.equal("hello");
    const saved = await bru.sendRequest({ method: "GET", url: bru.getEnvVar("baseUrl") + "/runs/" + run.id });
    expect(saved.data).to.deep.equal(run);
  });

}
