meta {
  name: Answer typed questions with Jev
  type: http
  seq: 10
  tags: [
    live-model
  ]
}

post {
  url: {{baseUrl}}/tasks/decide/runs
  body: json
  auth: none
}

body:json {
  {"inputs":{"text":"Please refund my damaged order. I want my money back, but I can still use the product.","questions":{"refund_requested":{"type":"boolean","question":"Is the customer asking for a refund?"},"category":{"type":"choice","question":"Which team should handle this request?","options":["billing","delivery","other"]},"urgency":{"type":"rubric","question":"How much is the customer blocked?","levels":["The customer can still use the product.","A workaround is required to use the product.","The customer cannot use the product."]}}}}
}

assert {
  res.status: eq 202
}

tests {
  const { waitForRun } = require("./helpers/runs.js");
  test("Jev returns named decisions and distributions", async function () {
    const run = await waitForRun(bru, res.getBody().id, { timeoutMs: 90000 });
    expect(run.status).to.equal("successful");
    const answers = run.result.answers;
    expect(answers.refund_requested.value).to.equal(true);
    expect(answers.refund_requested.probability_yes).to.be.within(0, 1);
    expect(answers.category.value).to.equal("billing");
    expect(answers.category.probabilities).to.have.all.keys("billing", "delivery", "other");
    expect(answers.urgency.value).to.equal(0);
    expect(answers.urgency.expected_score).to.be.within(0, 2);
    expect(answers.urgency.probabilities).to.have.all.keys("0", "1", "2");
    const saved = await bru.sendRequest({ method: "GET", url: bru.getEnvVar("baseUrl") + "/runs/" + run.id });
    expect(saved.data.result).to.deep.equal(run.result);
  });
}
