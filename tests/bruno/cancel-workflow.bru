meta {
  name: Cancel a durable workflow
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/workflows
  body: json
  auth: none
}

body:json {
  {"operation":"wait_then_add","inputs":{"seconds":2.0}}
}

assert {
  res.status: eq 202
}

tests {
  test("cancelled workflow remains retrievable", async function () {
    const url = bru.getEnvVar("baseUrl") + "/workflows/" + res.getBody().id;
    const cancelled = await bru.sendRequest({ method: "POST", url: url + "/cancel" });
    expect(cancelled.status).to.equal(200);
    expect(cancelled.data.status).to.equal("failed");
    const retrieved = await bru.sendRequest({ method: "GET", url });
    expect(retrieved.status).to.equal(200);
    expect(retrieved.data.error).to.equal("Workflow cancelled or time limit exceeded");
  });
}
