meta {
  name: Discover model generation
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/tasks
  auth: none
}

assert {
  res.status: eq 200
  res.body[0].id: eq generate
}

tests {
  test("discovery exposes Pydantic input and output schemas", function () {
    expect(res.getBody().map(item => item.id)).to.deep.equal(["generate", "dummy", "parse", "decide"]);
    const task = res.getBody().find(item => item.id === "generate");
    expect(task.input_schema.properties).to.have.property("prompt");
    expect(task.input_schema.properties).not.to.have.property("output_schema");
    expect(task.input_schema.properties).not.to.have.property("model");
    expect(task.output_schema.properties.output.type).to.equal("string");
    expect(task.output_schema.properties).not.to.have.property("model");
    expect(task.input_schema.properties).not.to.have.property("files");
    const parsing = res.getBody().find(item => item.id === "parse");
    expect(parsing.input_schema.required).to.deep.equal(["files"]);
    expect(parsing.input_schema.properties).not.to.have.property("prompt");
    expect(parsing.output_schema.properties.text.type).to.equal("string");
    const decision = res.getBody().find(item => item.id === "decide");
    expect(decision.input_schema.required).to.have.members(["text", "questions"]);
    expect(decision.input_schema.properties).not.to.have.property("question");
    expect(decision.output_schema.properties).to.have.property("answers");
  });
}
