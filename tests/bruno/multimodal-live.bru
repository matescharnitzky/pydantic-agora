meta {
  name: Read a PDF and image with OpenAI
  type: http
  seq: 10
  tags: [
    live-model
  ]
}

post {
  url: {{baseUrl}}/tasks/generate/runs
  body: json
  auth: none
}

body:json {
  {"inputs": {"prompt": "Two separate files are attached: a PDF and a PNG. Return the exact text from the PDF, then the solid color of the separate PNG image as a lowercase word (ignore the PDF background). Separate them with a space. Nothing else.", "files": [{"kind": "inline", "media_type": "application/pdf", "data": ""}, {"kind": "inline", "media_type": "image/png", "data": ""}]}}
}

assert {
  res.status: eq 202
}

tests {
  const { waitForRun } = require("./helpers/runs.js");
  test("PDF and image content produce a persisted answer", async function () {
    const run = await waitForRun(bru, res.getBody().id, { timeoutMs: 90000 });
    expect(run.status).to.equal("successful");
    expect(run.result.output.trim()).to.equal("AGORA-PDF red");
  });
}
