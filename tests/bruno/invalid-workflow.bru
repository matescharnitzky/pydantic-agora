meta {
  name: Reject an unregistered operation
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/workflows
  body: json
  auth: none
}

body:json {
  {"operation":"unregistered","inputs":{}}
}

assert {
  res.status: eq 422
}

tests {
  for (const operation of ["os.getenv", "__import__", "eval"]) {
    test("reject " + operation, async function () {
      await bru.sendRequest({
        method: "POST", url: bru.getEnvVar("baseUrl") + "/workflows",
        headers: { "Content-Type": "application/json" },
        data: { operation, inputs: { name: "POSTGRES_PASSWORD" } }
      }, (error, response) => {
        expect(error ? error.status : response.status).to.equal(422);
      });
    });
  }
}
