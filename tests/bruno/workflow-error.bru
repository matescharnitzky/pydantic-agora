meta {
  name: Retrieve a saved workflow failure
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/workflows
  body: json
  auth: none
}

body:json {
  {"operation":"divide_sum","inputs":{"left":2,"right":3,"divisor":0}}
}

assert {
  res.status: eq 202
}

tests {
  test("failed workflow remains retrievable", async function () {
    const url = bru.getEnvVar("baseUrl") + "/workflows/" + res.getBody().id;
    let workflow;
    for (let attempt = 0; attempt < 200; attempt++) {
      const response = await bru.sendRequest({ method: "GET", url });
      expect(response.status).to.equal(200);
      workflow = response.data;
      if (["successful", "failed"].includes(workflow.status)) break;
      await new Promise(resolve => setTimeout(resolve, 100));
    }
    expect(workflow.status).to.equal("failed");
    expect(workflow.result).to.equal(null);
    expect(workflow.error).to.equal("Workflow failed");
    expect(workflow.request.inputs).to.deep.equal({ left: 2, right: 3, divisor: 0 });
    expect(workflow.created_at).to.be.a("number");
    expect(workflow.updated_at).to.be.a("number");
    const saved = await bru.sendRequest({ method: "GET", url });
    expect(saved.status).to.equal(200);
    expect(saved.data).to.deep.equal(workflow);
  });
}
